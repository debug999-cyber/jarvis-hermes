# Скопируйте нужные строки в ~/.hermes/.env  (или используйте `hermes config set KEY value`)

# ── LLM (достаточно одного) ────────────────────────────────────────────────
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── API-сервер Hermes (нужен HUD; install.sh заполняет автоматически) ──────
API_SERVER_ENABLED=true
API_SERVER_KEY=
API_SERVER_PORT=8642
API_SERVER_HOST=127.0.0.1

# ── Голос (опционально) ───────────────────────────────────────────────────
GROQ_API_KEY=                 # быстрое облачное STT (whisper-large-v3-turbo)
ELEVENLABS_API_KEY=           # премиум TTS
PORCUPINE_ACCESS_KEY=         # если wake_word.provider: porcupine

# ── Мессенджеры (настраиваются через `hermes gateway setup`) ──────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ── Прочее ────────────────────────────────────────────────────────────────
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
